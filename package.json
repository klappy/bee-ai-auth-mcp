{
  "name": "bee-ai-auth-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Self-host-first, OAuth-secured MCP relay exposing a Bee pendant's retrieval API to any MCP client. Phase 1: auth core + whoami. Phase 2: read surface (bee_docs + bee_read). MIT.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:staging",
    "deploy:staging": "node scripts/gen-version.mjs && node scripts/deploy-staging.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke.live.test.ts",
    "test:image": "scripts/probe-bridge-image.sh bee-bridge:local",
    "test:handshake": "scripts/probe-broker-handshake.sh bee-bridge:local"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "jose": "^6.2.12",
    "tweetnacl": "^1.0.3",
    "uqr": "^0.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@cloudflare/workers-types": "^4.20260610.1",
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.129.1"
  }
}
